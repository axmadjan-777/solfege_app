{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent staged-tree QA review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewer", "baseSha", "stagedTreeSha", "model", "reasoningEffort", "reviewRound", "status", "summary", "findings", "observations", "limitations"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "reviewer": {"type": "string", "enum": ["independent_codex_cli", "independent_native_agent", "harness"]},
    "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "stagedTreeSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "model": {"type": "string", "const": "gpt-6.1-sol"},
    "reasoningEffort": {"type": "string", "const": "high"},
    "reviewRound": {"type": "integer", "minimum": 1, "maximum": 2},
    "status": {"type": "string", "enum": ["pass", "changes_requested", "blocked"]},
    "summary": {"type": "string", "minLength": 12, "maxLength": 12000},
    "findings": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/finding"}},
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "visual", "live"],
      "properties": {
        "tests": {"$ref": "#/$defs/observation"},
        "visual": {"$ref": "#/$defs/observation"},
        "live": {"$ref": "#/$defs/observation"}
      }
    },
    "limitations": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "detail"],
      "properties": {
        "path": {"type": "string", "pattern": "^(source/|evidence/|staged\\.diff$)", "maxLength": 1000},
        "detail": {"type": "string", "minLength": 8, "maxLength": 4000}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "detail"],
      "properties": {
        "status": {"type": "string", "enum": ["observed_pass", "observed_fail", "not_observed"]},
        "evidence": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/evidence"}},
        "detail": {"type": "string", "minLength": 8, "maxLength": 6000}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "title", "body", "location", "evidence"],
      "properties": {
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "title": {"type": "string", "minLength": 5, "maxLength": 200},
        "body": {"type": "string", "minLength": 20, "maxLength": 6000},
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "line"],
          "properties": {
            "path": {"type": "string", "pattern": "^(source/|evidence/|staged\\.diff$)", "maxLength": 1000},
            "line": {"type": "integer", "minimum": 1}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
